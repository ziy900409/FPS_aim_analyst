# dependencies
node_modules/

# build output
dist/

# vite / playwright caches
.vite/
test-results/
playwright-report/

# logs
*.log
npm-debug.log*

# os / editor
.DS_Store

# graphify — local-only artifacts (圖輸出本身追蹤；快取與機器路徑標記不追蹤)
graphify-out/cache/
graphify-out/.graphify_root

# WP-48 — local history root: real run JSON / lease file never committed, only the
# folder's placeholder README (docs/exec-plan/active/stage10/wp-48-local-history-foundation).
data/session-history/*
!data/session-history/README.md

# WP-48 T3 — Playwright's dev/preview history roots (NFR-48.6, never the real history root).
.playwright-tmp/

# WP-54 T6 — tracking pilot analysis output (participant exports and any artifact derived from
# them stay out of git; see docs/.../wp-54-tracking-pilot/T6-instrumentation-gate.md §7).
.pilot-analysis/

# WP-55 T7 — tracking contact analysis output (contact artifacts are derived from participant
# exports, so they stay out of git for the same reason as .pilot-analysis/; see
# docs/.../wp-55-tracking-on-target-observability-no-health/T7-operator-entry-point.md).
.contact-analysis/
