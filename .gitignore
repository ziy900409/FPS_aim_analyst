# dependencies
node_modules/

# build output
dist/

# vite / playwright caches
.vite/
test-results/
playwright-report/

# logs
*.log
npm-debug.log*

# os / editor
.DS_Store

# graphify — local-only artifacts (圖輸出本身追蹤；快取與機器路徑標記不追蹤)
graphify-out/cache/
graphify-out/.graphify_root

# WP-48 — local history root: real run JSON / lease file never committed, only the
# folder's placeholder README (docs/exec-plan/active/stage10/wp-48-local-history-foundation).
data/session-history/*
!data/session-history/README.md

# WP-48 T3 — Playwright's dev/preview history roots (NFR-48.6, never the real history root).
.playwright-tmp/

# WP-56 T6 — capture runner's temp history root (scripts/capture-wp56-visuals.mjs spawns the dev
# server with FPS_HISTORY_ROOT pointed here). Same class as .playwright-tmp/: never the real
# history root, never committed. See docs/known_issue/KI-028-*.md §7 for the orphaned-server bug
# that keeps writing into it.
.wp56-capture-tmp/

# WP-57 T6 — same for scripts/capture-wp57-visuals.mjs. That runner awaits its taskkill and then
# confirms the port went quiet before exiting, precisely so it does not reproduce KI-028.
.wp57-capture-tmp/

# WP-54 T6 — tracking pilot analysis output (participant exports and any artifact derived from
# them stay out of git; see docs/.../wp-54-tracking-pilot/T6-instrumentation-gate.md §7).
.pilot-analysis/

# WP-55 T7 — tracking contact analysis output (contact artifacts are derived from participant
# exports, so they stay out of git for the same reason as .pilot-analysis/; see
# docs/.../wp-55-tracking-on-target-observability-no-health/T7-operator-entry-point.md).
.contact-analysis/

# WP-57 — spider-shot-wide repositioning analysis output (npm run analyze:spider-wide). Same rule
# again: derived from participant exports. Note the wide-flick exports themselves are also NOT in
# this repo by decision D-57.T5-8; see docs/operational/spider-wide-recording-spec.md.
.spider-wide-analysis/

# WP-61 T2 — sensor-lift cohort audit output (npm run analyze:lift-cohort). Same rule as
# .spider-wide-analysis/: derived from participant exports, so it stays out of git. The annotated
# cohort exports themselves also never enter the repo (D-57.T5-8); see
# docs/operational/spider-wide-recording-spec.md §2.5.
.lift-cohort-analysis/
