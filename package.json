{
  "name": "fps-aim-analyst",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "capture:wp56-visuals": "node scripts/capture-wp56-visuals.mjs",
    "capture:wp56-visuals:interactive": "set HEADLESS=false&& node scripts/capture-wp56-visuals.mjs",
    "capture:wp57-visuals": "node scripts/capture-wp57-visuals.mjs",
    "capture:wp57-visuals:interactive": "set HEADLESS=false&& node scripts/capture-wp57-visuals.mjs",
    "analyze:contact": "vite-node scripts/analyze-tracking-contact.ts --",
    "analyze:spider-wide": "vite-node scripts/analyze-spider-wide-repositioning.ts --",
    "analyze:spider-v3": "vite-node scripts/analyze-spider-shot-v3.ts --",
    "record:lift-golden": "vite-node scripts/record-lift-segmentation-golden.ts --",
    "analyze:lift-cohort": "vite-node scripts/analyze-lift-cohort.ts --",
    "test:stage10": "node scripts/run-stage10-acceptance.mjs",
    "test:stage10:scale": "node scripts/run-stage10-scale-benchmark.mjs",
    "test:ci": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vitest run && playwright test"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.19.43",
    "@types/three": "^0.185.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
